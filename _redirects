# these keep behavior explicit under Git deploys and cover edge cases).
#
# Trailing slash after .html (e.g. /categories.html/) used to miss the
# pretty-URL redirect and SPA-fallback to the homepage — catch it first.
/*.html/ /:splat 308
/*.html /:splat 308
/index.php / 308
/blog /blog/ 308
