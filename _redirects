#
# Template-string leak URLs (e.g. /business/${b.s}) and undefined/null
# segments are redirected in functions/_middleware.js — ${} in _redirects
# is unreliable, and .html variants must not fall through to /*.html
# (that creates a 308→404 chain).

/index.html / 308
/index.html/ / 308
/blog/index.html /blog/ 308
/blog/index.html/ /blog/ 308
/index.php / 308
/blog /blog/ 308
